<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.LinkedOrganizationManagementController">

    <left>
        <VBox alignment="TOP_CENTER"
              prefWidth="70.0"
              spacing="18.0"
              style="-fx-background-color:#4a90e2;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" top="20.0" />
            </padding>
            <StackPane prefHeight="40.0"
                       prefWidth="40.0"
                       style="-fx-background-color: #e8a020; -fx-background-radius: 10;">
                <children>
                    <Label text="PC" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                </children>
            </StackPane>
            <Button fx:id="btnHome"
                    mnemonicParsing="false"
                    onAction="#goHome"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: rgba(255,255,255,0.16); -fx-background-radius: 10;"
                    text="H"
                    textFill="WHITE" />
            <Button fx:id="btnIntern"
                    mnemonicParsing="false"
                    onAction="#goInternModule"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent;"
                    text="A"
                    textFill="WHITE" />
            <Button fx:id="btnReports"
                    mnemonicParsing="false"
                    onAction="#goReportsModule"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent;"
                    text="R"
                    textFill="WHITE" />
            <Button fx:id="btnProjects"
                    mnemonicParsing="false"
                    onAction="#goProjectsModule"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent;"
                    text="P"
                    textFill="WHITE" />
            <Button fx:id="btnLinkedOrganization"
                    mnemonicParsing="false"
                    onAction="#goLinkedOrganizationModule"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: rgba(255,255,255,0.16); -fx-background-radius: 10;"
                    text="O"
                    textFill="WHITE" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="btnExit"
                    mnemonicParsing="false"
                    onAction="#logOut"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent;"
                    text="S"
                    textFill="WHITE" />
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Organizaciones vinculadas" textFill="#1a2744">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    <Label text="Consulte las organizaciones registradas y sus datos de contacto."
                           textFill="#6b7280" />
                </VBox>
                <Button mnemonicParsing="false"
                        onAction="#goRegisterOrganization"
                        prefHeight="38.0"
                        style="-fx-background-color: #4a90e2; -fx-background-radius: 8; -fx-text-fill: white;"
                        text="Registrar organizacion" />
            </HBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: rgba(0,0,0,0.08); -fx-border-radius: 12;">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>
                <HBox spacing="8.0">
                    <TextField fx:id="txtSearchName"
                               onAction="#validateSearchOrganization"
                               promptText="Buscar por nombre, correo, pais, estado, ciudad o sector"
                               HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false"
                            onAction="#validateSearchOrganization"
                            prefHeight="34.0"
                            style="-fx-background-color: #1a2744; -fx-background-radius: 8; -fx-text-fill: white;"
                            text="Buscar" />
                </HBox>

                <TableView fx:id="tblOrganizations" prefHeight="470.0">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="190.0" text="Organizacion" />
                        <TableColumn fx:id="colEmail" prefWidth="190.0" text="Correo" />
                        <TableColumn fx:id="colPhoneNumber" prefWidth="110.0" text="Telefono" />
                        <TableColumn fx:id="colCountry" prefWidth="130.0" text="Pais" />
                        <TableColumn fx:id="colState" prefWidth="140.0" text="Estado" />
                        <TableColumn fx:id="colCity" prefWidth="140.0" text="Ciudad" />
                        <TableColumn fx:id="colSector" prefWidth="130.0" text="Sector" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
