<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
 
<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.ProjectDetailsDashboardController"
            style="-fx-background-color: #f8fafc;"
            prefWidth="800.0"
            prefHeight="650.0">
 
    <children>
        <VBox AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              spacing="0">
            <children>
                <!-- Top Navigation Bar -->
                <HBox alignment="CENTER_LEFT"
                      spacing="15"
                      style="-fx-background-color: white;
                             -fx-border-color: #e2e8f0;
                             -fx-border-width: 0 0 1 0;
                             -fx-padding: 12 24 12 24;">
                    <children>
                        <Button fx:id="btnBack"
                                text="←"
                                onAction="#handleBtnBack"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #1e293b;
                                       -fx-font-size: 20px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 0 10 0 0;
                                       -fx-cursor: hand;" />
 
                        <Label text="Detalles del Proyecto"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b;" />
                    </children>
                </HBox>
 
                <!-- Main Content Area -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            style="-fx-background: #f8fafc;
                                   -fx-background-color: transparent;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20" style="-fx-padding: 24;">
                            <children>
                                <!-- Header Block Card -->
                                <VBox spacing="16"
                                      style="-fx-background-color: white;
                                             -fx-background-radius: 16;
                                             -fx-padding: 20;
                                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.04), 10, 0.1, 0, 4);">
                                    <children>
                                        <!-- Decorative cover background -->
                                        <StackPane fx:id="pneHeaderCover"
                                                   prefHeight="140.0"
                                                   style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                                                          -fx-background-radius: 12;">
                                            <children>
                                                <Label fx:id="lblLargeInitial"
                                                       text="P"
                                                       style="-fx-font-size: 55px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: white;
                                                              -fx-opacity: 0.25;" />
                                            </children>
                                        </StackPane>
 
                                        <!-- Badges row -->
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <children>
                                                <Label fx:id="lblStatus"
                                                       text="PUBLICADO/ACTIVO"
                                                       style="-fx-background-color: #dcfce7;
                                                              -fx-text-fill: #166534;
                                                              -fx-font-size: 11px;
                                                              -fx-font-weight: bold;
                                                              -fx-background-radius: 20;
                                                              -fx-padding: 4 10 4 10;" />
                                            </children>
                                        </HBox>
 
                                        <!-- Title -->
                                        <VBox spacing="4">
                                            <children>
                                                <Label fx:id="lblProjectName"
                                                       text="Project Name"
                                                       wrapText="true"
                                                       style="-fx-font-size: 22px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #0f172a;" />
 
                                                <Label fx:id="lblOrganization"
                                                       text="Organization Subtitle"
                                                       style="-fx-font-size: 14px;
                                                              -fx-text-fill: #64748b;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Info Cards Grid -->
                                <HBox spacing="16">
                                    <children>
                                        <!-- Card: Responsible -->
                                        <VBox HBox.hgrow="ALWAYS"
                                              spacing="8"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 12;
                                                     -fx-padding: 16;
                                                     -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label text="Responsable"
                                                       style="-fx-font-size: 11px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #64748b;
                                                              -fx-letter-spacing: 0.5;" />
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <children>
                                                        <StackPane style="-fx-background-color: #cbd5e1;
                                                                          -fx-background-radius: 99;
                                                                          -fx-min-width: 24;
                                                                          -fx-min-height: 24;
                                                                          -fx-max-width: 24;
                                                                          -fx-max-height: 24;">
                                                            <children>
                                                                <Label text="👤"
                                                                       style="-fx-font-size: 12px;
                                                                              -fx-text-fill: #475569;" />
                                                            </children>
                                                        </StackPane>
                                                        <Label fx:id="lblResponsible"
                                                               text="Responsible Name"
                                                               style="-fx-font-size: 13px;
                                                                      -fx-font-weight: bold;
                                                                      -fx-text-fill: #1e293b;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
 
                                        <!-- Card: Methodology -->
                                        <VBox HBox.hgrow="ALWAYS"
                                              spacing="8"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 12;
                                                     -fx-padding: 16;
                                                     -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label text="Metodología"
                                                       style="-fx-font-size: 11px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #64748b;
                                                              -fx-letter-spacing: 0.5;" />
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <children>
                                                        <StackPane style="-fx-background-color: #cbd5e1;
                                                                          -fx-background-radius: 99;
                                                                          -fx-min-width: 24;
                                                                          -fx-min-height: 24;
                                                                          -fx-max-width: 24;
                                                                          -fx-max-height: 24;">
                                                            <children>
                                                                <Label text="⚙"
                                                                       style="-fx-font-size: 12px;
                                                                              -fx-text-fill: #475569;" />
                                                            </children>
                                                        </StackPane>
                                                        <Label fx:id="lblMethodology"
                                                               text="Methodology Name"
                                                               style="-fx-font-size: 13px;
                                                                      -fx-font-weight: bold;
                                                                      -fx-text-fill: #1e293b;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
 
                                <!-- Detailed Sections -->
                                
                                <!-- Description -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="ℹ" style="-fx-font-size: 14px; -fx-text-fill: #3b82f6; -fx-font-weight: bold;" />
                                                <Label text="Descripción General" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label fx:id="lblDescription"
                                                       text="General description details..."
                                                       wrapText="true"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #334155; -fx-line-spacing: 2;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Objetivo General -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="🎯" style="-fx-font-size: 14px; -fx-text-fill: #10b981; -fx-font-weight: bold;" />
                                                <Label text="Objetivo General" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label fx:id="lblGeneralObjective"
                                                       text="General objective details..."
                                                       wrapText="true"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #334155; -fx-line-spacing: 2;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Objetivos Inmediatos -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="⚡" style="-fx-font-size: 14px; -fx-text-fill: #f59e0b; -fx-font-weight: bold;" />
                                                <Label text="Objetivos Inmediatos" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label fx:id="lblImmediateObjectives"
                                                       text="Immediate objectives..."
                                                       wrapText="true"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #334155; -fx-line-spacing: 2;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Objetivos Mediatos -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="📅" style="-fx-font-size: 14px; -fx-text-fill: #8b5cf6; -fx-font-weight: bold;" />
                                                <Label text="Objetivos Mediatos" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label fx:id="lblMediateObjectives"
                                                       text="Mediate objectives..."
                                                       wrapText="true"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #334155; -fx-line-spacing: 2;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Recursos -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="🛠" style="-fx-font-size: 14px; -fx-text-fill: #06b6d4; -fx-font-weight: bold;" />
                                                <Label text="Recursos" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <FlowPane fx:id="fpnResources"
                                                          hgap="8.0"
                                                          vgap="8.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
 
                                <!-- Responsabilidades -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="💼" style="-fx-font-size: 14px; -fx-text-fill: #ec4899; -fx-font-weight: bold;" />
                                                <Label text="Responsabilidades" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <Label fx:id="lblResponsibilities"
                                                       text="Responsibilities details..."
                                                       wrapText="true"
                                                       style="-fx-font-size: 13px; -fx-text-fill: #334155; -fx-line-spacing: 2;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Actividades del Proyecto -->
                                <VBox spacing="8">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="📋" style="-fx-font-size: 14px; -fx-text-fill: #6366f1; -fx-font-weight: bold;" />
                                                <Label text="Plan de Trabajo (Actividades)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            </children>
                                        </HBox>
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.03), 8, 0.08, 0, 2);">
                                            <children>
                                                <VBox fx:id="vbxActivitiesContainer" spacing="10" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
