<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.internshipprogramsystem.gui.controllers.DocumentHomeDashboardController">
    
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="70.0" spacing="20.0" style="-fx-background-color:#4a90e2;" BorderPane.alignment="CENTER">
            <children>
                <StackPane prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #e8a020; -fx-background-radius: 10;">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <children>
                        <Label text="ES" textFill="WHITE">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                    </children>
                </StackPane>
                <Button fx:id="btnHome" 
                        mnemonicParsing="false" 
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: transparent;" 
                        text="⌂" 
                        textFill="WHITE"
                        onAction="#goHome"/>
                <Button fx:id="btnProjects" 
                        mnemonicParsing="false" 
                        onAction="#goProjectsModule" 
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: transparent;" 
                        text="🛠️" 
                        textFill="WHITE" />
                
                <Button mnemonicParsing="false" 
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10;" 
                        text="📑" 
                        textFill="WHITE" />
                        
                <Button fx:id="btnReports" 
                        mnemonicParsing="false" 
                        onAction="#goReportsModule" 
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: transparent;" 
                        text="📋" 
                        textFill="WHITE" />
                <Button fx:id="btnSelfAssessments" 
                        mnemonicParsing="false" 
                        onAction="#goSelfAssessmentsModule" 
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: transparent;" 
                        text="📝" 
                        textFill="WHITE" />
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="btnExit" 
                        mnemonicParsing="false" 
                        onAction="#logOut"
                        prefHeight="40.0" 
                        prefWidth="40.0" 
                        style="-fx-background-color: transparent;" 
                        text="🚪" 
                        textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Gestión de Documentos" textFill="#1a2744">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                        </Label>
                                        <Label text="Sube, administra y consulta el estado de tus documentos obligatorios." textFill="#6b7280" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <children>
                                
                                <VBox style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: rgba(0,0,0,0.07); -fx-border-radius: 13;" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="Mis Archivos" textFill="#1a2744">
                                                    <font><Font name="System Bold" size="16.0" /></font>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                            </children>
                                            <VBox.margin>
                                                <Insets bottom="12.0" />
                                            </VBox.margin>
                                        </HBox>
                                        
                                        <TableView fx:id="tblDocuments" prefHeight="450.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                                            <columns>
                                                <TableColumn fx:id="colDocumentType" prefWidth="250.0" text="Tipo de Documento" />
                                                <TableColumn fx:id="colUploadDate" prefWidth="180.0" text="Fecha de Subida" />
                                                <TableColumn fx:id="colStatus" prefWidth="180.0" text="Estado Actual" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox prefWidth="320.0" spacing="16.0">
                                    <children>
                                        
                                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: rgba(0,0,0,0.07); -fx-border-radius: 13;">
                                            <padding>
                                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #EBF3FF; -fx-background-radius: 9;">
                                                            <children><Label text="↑" textFill="#4a90e2" style="-fx-font-weight: bold; -fx-font-size: 16;" /></children>
                                                        </StackPane>
                                                        <Label text="Subir Documento" textFill="#1a2744">
                                                            <font><Font name="System Bold" size="15.0" /></font>
                                                        </Label>
                                                    </children>
                                                </HBox>
                                                
                                                <Label text="Seleccione el tipo de documento que desea entregar al sistema:" textFill="#6b7280" wrapText="true" />
                                                
                                                <ComboBox fx:id="cmbDocumentType" maxWidth="Infinity" promptText="Seleccionar tipo..." style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                                
                                                <Button fx:id="btnUploadDocument" maxWidth="Infinity" mnemonicParsing="false" onAction="#uploadSelectedDocument" prefHeight="38.0" style="-fx-background-color: #1a2744; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;" text="Seleccionar archivo y subir" />
                                                
                                                <Label fx:id="lblSystemMessage" text="" textFill="#6b7280" wrapText="true" style="-fx-font-size: 12;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: rgba(0,0,0,0.07); -fx-border-radius: 13;">
                                            <padding>
                                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #FEF3E7; -fx-background-radius: 9;">
                                                            <children><Label text="💬" textFill="#e8a020" style="-fx-font-size: 14;"/></children>
                                                        </StackPane>
                                                        <Label text="Retroalimentación" textFill="#1a2744">
                                                            <font><Font name="System Bold" size="15.0" /></font>
                                                        </Label>
                                                    </children>
                                                </HBox>
                                                
                                                <Label text="Seleccione un documento de la tabla para leer las observaciones de su profesor." textFill="#6b7280" wrapText="true" />
                                                
                                                <Button fx:id="btnViewComments" maxWidth="Infinity" mnemonicParsing="false" onAction="#viewDocumentComments" prefHeight="38.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151; -fx-font-weight: bold;" text="Ver comentarios" />
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>