<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="850.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.internshipprogramsystem.gui.controllers.ProjectDetailsInternController">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #ffffff;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label fx:id="lblProjectName" text="Nombre del Proyecto" textFill="#1a2744" wrapText="true">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblOrganization" text="Organización Vinculada" textFill="#4a90e2">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Descripción General:" textFill="#4b5563">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblDescription" text="Cargando..." textFill="#374151" wrapText="true">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Objetivos:" textFill="#4b5563">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblObjectives" text="Cargando..." textFill="#374151" wrapText="true">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Metodología y Recursos:" textFill="#4b5563">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblMethodology" text="Cargando..." textFill="#374151" wrapText="true">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Responsabilidades:" textFill="#4b5563">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="lblResponsibilities" text="Cargando..." textFill="#374151" wrapText="true">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Cronograma de Actividades:" textFill="#4b5563">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <VBox fx:id="vboxActivitiesList" spacing="8.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                           </VBox>
                     </children>
                  </VBox>
                  </children>
            </VBox>
         </content>
      </ScrollPane>

      <HBox alignment="CENTER_RIGHT" prefHeight="60.0" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Button fx:id="btnClose" mnemonicParsing="false" onAction="#closeWindow" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #4b5563;" text="Cerrar">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>