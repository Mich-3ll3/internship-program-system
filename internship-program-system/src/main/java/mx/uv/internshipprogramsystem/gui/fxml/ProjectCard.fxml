<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
 
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="0"
      style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-border-radius: 16;
             -fx-border-color: #e2e8f0;
             -fx-border-width: 1;
             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 12, 0.12, 0, 4);">
 
    <children>
        <HBox alignment="CENTER_LEFT" spacing="0">
            <children>
                <!-- Left Section: Visual Placeholder/Image -->
                <StackPane fx:id="pneImagePlaceholder"
                           prefWidth="220.0"
                           prefHeight="160.0"
                           minWidth="220.0"
                           minHeight="160.0"
                           maxWidth="220.0"
                           maxHeight="160.0"
                           style="-fx-background-color: linear-gradient(to bottom right, #e0e7ff, #c7d2fe);
                                  -fx-background-radius: 16 0 0 16;
                                  -fx-border-radius: 16 0 0 16;">
                    <children>
                        <Label fx:id="lblInitials"
                               text="P"
                               style="-fx-font-size: 40px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #4f46e5;
                                      -fx-opacity: 0.85;" />
                    </children>
                </StackPane>
 
                <!-- Right Section: Details -->
                <VBox HBox.hgrow="ALWAYS" spacing="12">
                    <padding>
                        <Insets top="16.0" right="20.0" bottom="16.0" left="20.0" />
                    </padding>
                    <children>
                        <!-- Header Row: Title, Status, Action Buttons -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label fx:id="lblProjectName"
                                       text="Project Name"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1e293b;" />
 
                                <Label fx:id="lblStatus"
                                       text="Activo"
                                       style="-fx-background-color: #dcfce7;
                                              -fx-text-fill: #166534;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-background-radius: 20;
                                              -fx-padding: 3 8 3 8;" />
 
                                <Region HBox.hgrow="ALWAYS" />
 
                                <HBox spacing="8">
                                    <children>
                                        <Button fx:id="btnViewProject"
                                                text="Ver"
                                                style="-fx-background-color: #f1f5f9;
                                                       -fx-text-fill: #475569;
                                                       -fx-font-size: 12px;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 8;
                                                       -fx-padding: 6 12 6 12;
                                                       -fx-cursor: hand;" />
 
                                        <Button fx:id="btnEditProject"
                                                text="Editar"
                                                style="-fx-background-color: #eff6ff;
                                                       -fx-text-fill: #2563eb;
                                                       -fx-font-size: 12px;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 8;
                                                       -fx-padding: 6 12 6 12;
                                                       -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
 
                        <!-- General Description -->
                        <Label fx:id="lblDescription"
                               text="General description goes here..."
                               wrapText="true"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #475569;
                                      -fx-line-spacing: 2;"
                               maxHeight="38.0"
                               minHeight="38.0" />
 
                        <!-- Column Grid details -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>
                                <!-- Objective column -->
                                <VBox spacing="2" prefWidth="130.0">
                                    <children>
                                        <Label text="OBJETIVO"
                                               style="-fx-font-size: 9px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #64748b;
                                                      -fx-letter-spacing: 0.5;" />
                                        <Label fx:id="lblObjective"
                                               text="Objective general details..."
                                               style="-fx-font-size: 11px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #334155;"
                                               wrapText="false" />
                                    </children>
                                </VBox>
 
                                <!-- Methodology column -->
                                <VBox spacing="2" prefWidth="100.0">
                                    <children>
                                        <Label text="METODOLOGÍA"
                                               style="-fx-font-size: 9px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #64748b;
                                                      -fx-letter-spacing: 0.5;" />
                                        <Label fx:id="lblMethodology"
                                               text="Methodology"
                                               style="-fx-font-size: 11px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #334155;" />
                                    </children>
                                </VBox>
 
                                <!-- Organization column -->
                                <VBox spacing="2" prefWidth="120.0">
                                    <children>
                                        <Label text="ORGANIZACIÓN"
                                               style="-fx-font-size: 9px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #64748b;
                                                      -fx-letter-spacing: 0.5;" />
                                        <Label fx:id="lblOrganization"
                                               text="Organization Name"
                                               style="-fx-font-size: 11px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #334155;" />
                                    </children>
                                </VBox>
 
                                <!-- Responsible column -->
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="RESPONSABLE"
                                               style="-fx-font-size: 9px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #64748b;
                                                      -fx-letter-spacing: 0.5;" />
                                        <HBox alignment="CENTER_LEFT" spacing="6">
                                            <children>
                                                <StackPane style="-fx-background-color: #cbd5e1;
                                                                  -fx-background-radius: 99;
                                                                  -fx-min-width: 18;
                                                                  -fx-min-height: 18;
                                                                  -fx-max-width: 18;
                                                                  -fx-max-height: 18;">
                                                    <children>
                                                        <Label text="👤"
                                                               style="-fx-font-size: 10px;
                                                                      -fx-text-fill: #475569;" />
                                                    </children>
                                                </StackPane>
                                                <Label fx:id="lblResponsible"
                                                       text="Responsible Name"
                                                       style="-fx-font-size: 11px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #334155;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>