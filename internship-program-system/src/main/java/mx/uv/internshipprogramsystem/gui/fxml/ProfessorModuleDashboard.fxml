<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    prefHeight="700.0"
    prefWidth="1000.0"
    style="-fx-background-color: #f3f6fb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="mx.uv.internshipprogramsystem.gui.controllers.ProfessorManagementController">



    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="26.0" left="30.0" right="30.0" top="28.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Gestion de profesores" textFill="#14213d">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>

                                <Label
                                    text="Consulta, registro, modificacion y cambio de estado de profesores."
                                    textFill="#64748b">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Button
                            mnemonicParsing="false"
                            onAction="#goRegisterProfessor"
                            prefHeight="38.0"
                            style="-fx-background-color: #3f8fe5; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                            text="+ Nuevo profesor" />
                    </children>
                </HBox>

                <VBox
                    spacing="16.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0.16, 0, 4);">

                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField
                                    fx:id="txtSearchStaffNumber"
                                    onAction="#searchProfessor"
                                    onKeyReleased="#handleLiveSearchProfessor"
                                    prefHeight="40.0"
                                    promptText="Buscar por numero, correo, nombre o NRC"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1; -fx-padding: 0 14 0 14;"
                                    HBox.hgrow="ALWAYS" />

                                <Button
                                    mnemonicParsing="false"
                                    onAction="#searchProfessor"
                                    prefHeight="40.0"
                                    style="-fx-background-color: #14213d; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                                    text="Buscar" />
                            </children>
                        </HBox>

                        <TableView
                            fx:id="tblProfessors"
                            prefHeight="340.0"
                            style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #dbe1ea; -fx-padding: 0; -fx-selection-bar: #dbeafe; -fx-selection-bar-non-focused: #dbeafe; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 12, 0.15, 0, 3);">

                            <columns>
                                <TableColumn fx:id="colStaffNumber" text="No. personal" />
                                <TableColumn fx:id="colName" text="Nombre" />
                                <TableColumn fx:id="colEmail" text="Correo institucional" />
                                <TableColumn fx:id="colCoordinator" text="Coordinador" />
                                <TableColumn fx:id="colStatus" text="Estado" />

                            </columns>
                        </TableView>

                        <HBox
                            alignment="CENTER_RIGHT"
                            spacing="10.0"
                            style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14;">

                            <padding>
                                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
                            </padding>

                            <children>
                                <Label
                                    text="Seleccione un profesor para modificarlo o cambiar su estado."
                                    textFill="#64748b"
                                    HBox.hgrow="ALWAYS" />

                                <Button
                                    mnemonicParsing="false"
                                    onAction="#goUpdateProfessor"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #e0ecff; -fx-background-radius: 12; -fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                                    text="Modificar profesor" />

                                <Button
                                    mnemonicParsing="false"
                                    onAction="#handleChangeProfessorStatus"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #fee2e2; -fx-background-radius: 12; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                                    text="Activar / Inactivar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
