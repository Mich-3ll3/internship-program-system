<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="pneDashboardLayout"
            prefHeight="700.0"
            prefWidth="1000.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.MainDashboardLayoutController">
    <left>
        <fx:include fx:id="pneSideMenu" source="SideMenuDashboard.fxml" />
    </left>
    <center>
        <BorderPane fx:id="pneContentPane">
            <top>
                <HBox fx:id="pneHeaderBar" alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15 30 15 30; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="lblDashboardTitle"
                                       textFill="#4a90e2"
                                       style="-fx-font-size: 13; -fx-font-weight: bold;"
                                       visible="false"
                                       managed="false" />
                                <Label fx:id="lblWelcomeMessage"
                                       text="Cargando..."
                                       textFill="#1a2744"
                                       style="-fx-font-size: 16; -fx-font-weight: bold;" />
                                <Label fx:id="lblDate"
                                       textFill="#6b7280"
                                       style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane fx:id="pneAvatarContainer"
                                   onMouseClicked="#handlePneAvatarClick"
                                   prefHeight="40.0"
                                   prefWidth="40.0"
                                   style="-fx-cursor: hand;">
                            <children>
                                <Circle radius="20.0"
                                        fill="#4a90e2" />
                                <Label fx:id="lblUserInitials"
                                       text="US"
                                       textFill="WHITE"
                                       style="-fx-font-size: 14; -fx-font-weight: bold;" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="pneViewContainer" style="-fx-background-color: #f5f6fa;" />
            </center>
        </BorderPane>
    </center>
</BorderPane>
