<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    fx:controller="mx.uv.internshipprogramsystem.gui.controllers.EducationalExperienceRegisterDashboardController"
    prefHeight="700.0"
    prefWidth="1000.0"
    style="-fx-background-color: #f3f6fb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1">

    <left>
        <VBox
            alignment="TOP_CENTER"
            prefWidth="72.0"
            spacing="22.0"
            style="-fx-background-color: #3f8fe5;"
            BorderPane.alignment="CENTER">

            <children>
                <StackPane
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: #f2a91b; -fx-background-radius: 12;">
                    <VBox.margin>
                        <Insets top="22.0" />
                    </VBox.margin>
                    <children>
                        <Label text="PC" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </StackPane>

                <Button
                    fx:id="btnHome"
                    mnemonicParsing="false"
                    onAction="#goHome"
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="âŒ‚"
                    textFill="WHITE" />

                <Button
                    fx:id="btnEducationalExperience"
                    mnemonicParsing="false"
                    onAction="#goEducationalExperienceModule"
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: rgba(255,255,255,0.16); -fx-background-radius: 12; -fx-cursor: hand;"
                    text="ðŸ“š"
                    textFill="WHITE" />

                <Button
                    fx:id="btnIntern"
                    mnemonicParsing="false"
                    onAction="#goInternModule"
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="ðŸ‘¥"
                    textFill="WHITE" />

                <Button
                    fx:id="btnProject"
                    mnemonicParsing="false"
                    onAction="#goProjectsModule"
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="ðŸ› ï¸"
                    textFill="WHITE" />

                <Region VBox.vgrow="ALWAYS" />

                <Button
                    fx:id="btnExit"
                    mnemonicParsing="false"
                    onAction="#logOut"
                    prefHeight="42.0"
                    prefWidth="42.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="ðŸšª"
                    textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="22.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="26.0" left="30.0" right="30.0" top="28.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Registrar experiencia educativa" textFill="#14213d">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label
                                    text="Capture el NRC, periodo, seccion, profesor y fechas administrativas."
                                    textFill="#64748b">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox
                    spacing="18.0"
                    style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0.16, 0, 4);">

                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>

                    <children>
                        <GridPane hgap="18.0" vgap="16.0">
                            <columnConstraints>
                                <javafx.scene.layout.ColumnConstraints percentWidth="30.0" />
                                <javafx.scene.layout.ColumnConstraints percentWidth="70.0" />
                            </columnConstraints>

                            <children>
                                <Label text="NRC" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField
                                    fx:id="txtNrc"
                                    promptText="Ejemplo: 50562"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1; -fx-padding: 0 14 0 14;"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0" />

                                <Label text="Ciclo" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <ComboBox
                                    fx:id="cmbSchoolTerm"
                                    maxWidth="Infinity"
                                    promptText="Seleccione el ciclo"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1;"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1" />

                                <Label text="Año de inicio" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField
                                    fx:id="txtSchoolYear"
                                    promptText="Ejemplo: 2026"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1; -fx-padding: 0 14 0 14;"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2" />

                                <Label text="Seccion" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField
                                    fx:id="txtSection"
                                    promptText="Ejemplo: 1"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1; -fx-padding: 0 14 0 14;"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3" />

                                <Label text="Fecha inicio" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <DatePicker
                                    fx:id="dpStartDate"
                                    maxWidth="Infinity"
                                    promptText="Seleccione fecha de inicio"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4" />

                                <Label text="Fecha fin" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <DatePicker
                                    fx:id="dpEndDate"
                                    maxWidth="Infinity"
                                    promptText="Seleccione fecha de fin"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="5" />

                                <Label text="Profesor" textFill="#14213d" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                <ComboBox
                                    fx:id="cmbProfessor"
                                    maxWidth="Infinity"
                                    promptText="Seleccione un profesor"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cbd5e1;"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="6" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button
                                    fx:id="btnCancel"
                                    mnemonicParsing="false"
                                    onAction="#clearForm"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #eef2f7; -fx-background-radius: 12; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                                    text="Cancelar" />

                                <Button
                                    fx:id="btnRegisterEducationalExperience"
                                    mnemonicParsing="false"
                                    onAction="#validateRegisterEducationalExperienceForm"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #3f8fe5; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 18 0 18;"
                                    text="Registrar experiencia" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
