<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25.0.3"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.RegisterActivityFormController"
            prefHeight="720.0"
            prefWidth="1080.0"
            style="-fx-background-color: #f4f7fb;">

    <left>
        <VBox alignment="TOP_CENTER"
              prefWidth="70.0"
              spacing="20.0"
              style="-fx-background-color:#4a90e2;">

            <children>
                <StackPane prefHeight="40.0"
                           prefWidth="40.0"
                           style="-fx-background-color: #e8a020; -fx-background-radius: 10;">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>

                    <children>
                        <Label text="PC" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </StackPane>

                <Button fx:id="btnHome"
                        onAction="#goHome"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="⌂"
                        textFill="WHITE"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10;" />

                <Button fx:id="btnEducationalExperience"
                        onAction="#goEducationalExperienceModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="📚"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Button fx:id="btnIntern"
                        onAction="#goInternModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="👥"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Button fx:id="btnLinkedOrganization"
                        onAction="#goLinkedOrganizationModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="🏢"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Button fx:id="btnProjects"
                        onAction="#goProjectsModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="🛠️"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Button fx:id="btnDocuments"
                        onAction="#goDocumentsModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="📑"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Button fx:id="btnReports"
                        onAction="#goReportsModule"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="📋"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnExit"
                        onAction="#logOut"
                        prefHeight="40.0"
                        prefWidth="40.0"
                        text="🚪"
                        textFill="WHITE"
                        style="-fx-background-color: transparent;">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="22.0"
              style="-fx-padding: 30 40 30 40;">

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Registrar Plan de Trabajo"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                    <Label text="Complete la información para registrar y administrar las actividades del proyecto."
                           style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                </VBox>

                <Button fx:id="btnCancel"
                        text="Cancelar"
                        onAction="#handleBtnCancel"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 22 12 22;" />

                <Button fx:id="btnSaveActivity"
                        text="Guardar plan"
                        onAction="#handleBtnSaveActivity"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 24 12 24;" />
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

                <content>
                    <VBox spacing="20.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #dbe1ea; -fx-padding: 26; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 12, 0.15, 0, 3);">

                        <Label text="Detalles de la actividad"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                        <Separator />

                        <VBox spacing="8.0">
                            <Label text="Proyecto asociado"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                            <ComboBox fx:id="cmbProject"
                                      promptText="Selecciona un proyecto"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10;" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Nombre de la actividad"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                            <TextField fx:id="txtActivityName"
                                       promptText="Ej. Desarrollo de Frontend"
                                       style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 10;" />
                        </VBox>

                        <HBox spacing="16.0">
                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <Label text="Mes"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                                <TextField fx:id="txtActivityMonth"
                                           promptText="Ej. Septiembre"
                                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 10;" />
                            </VBox>

                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <Label text="Semana de inicio"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                                <TextField fx:id="txtActivityStartWeek"
                                           promptText="Ej. 1"
                                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 10;" />
                            </VBox>

                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <Label text="Semana de fin"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                                <TextField fx:id="txtActivityEndWeek"
                                           promptText="Ej. 3"
                                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 10;" />
                            </VBox>

                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <Label text="Horas planeadas"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />

                                <TextField fx:id="txtActivityPlannedHours"
                                           promptText="Ej. 40"
                                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 10;" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnAddActivityToList"
                                        text="Agregar al plan"
                                        onAction="#handleBtnAddActivityToList"
                                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16 8 16; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Separator />

                        <Label text="Actividades en el plan"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                        <TableView fx:id="tblActivities"
                                   prefHeight="200.0"
                                   style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #cbd5e1; -fx-padding: 0; -fx-selection-bar: #dbeafe; -fx-selection-bar-non-focused: #dbeafe;">
                            <columns>
                                <TableColumn fx:id="colName" text="Nombre de actividad" prefWidth="250.0" />
                                <TableColumn fx:id="colMonth" text="Mes" prefWidth="120.0" />
                                <TableColumn fx:id="colStartWeek" text="Semana inicio" prefWidth="100.0" />
                                <TableColumn fx:id="colEndWeek" text="Semana fin" prefWidth="100.0" />
                                <TableColumn fx:id="colPlannedHours" text="Horas planeadas" prefWidth="120.0" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="btnRemoveActivityFromList"
                                        text="Quitar actividad seleccionada"
                                        onAction="#handleBtnRemoveActivityFromList"
                                        style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16 8 16; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
