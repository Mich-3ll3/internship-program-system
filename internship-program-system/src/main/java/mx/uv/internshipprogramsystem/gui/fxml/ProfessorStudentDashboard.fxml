<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.ProfessorStudentDashboardController">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="20.0">
                    <padding><Insets bottom="24.0" left="30.0" right="30.0" top="30.0" /></padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Panel del Profesor" textFill="#1a2744">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                        </Label>
                                        <Label text="Consulta de Estudiantes Asignados" textFill="#6b7280">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="20.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; 
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 12; 
                                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane prefHeight="36.0" prefWidth="36.0"
                                                   style="-fx-background-color: #EBF3FF; -fx-background-radius: 10;">
                                            <children>
                                                <Label text="🎓" textFill="#4a90e2">
                                                    <font><Font name="System Bold" size="16.0" /></font>
                                                </Label>
                                            </children>
                                        </StackPane>
                                        <Label text="Listado de Estudiantes" textFill="#1a2744">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 5 0;">
                                    <children>
                                        <Label text="🔍 Buscar:" textFill="#4b5563">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <TextField fx:id="txtSearch" promptText="Matrícula o Nombre..." 
                                                   prefWidth="250.0"
                                                   style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 10;" />
                                        <Button text="Buscar" onAction="#handleSearch"
                                                style="-fx-background-color: white; -fx-text-fill: #4b5563; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" />
                                        <Button text="Limpiar" onAction="#handleClearSearch"
                                                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand; -fx-underline: true;" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tblStudents" prefHeight="280.0" 
                                           style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                                    <columns>
                                        <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="120"/>
                                        <TableColumn fx:id="colName" text="Nombre del Estudiante" prefWidth="250"/>
                                        <TableColumn fx:id="colProject" text="Proyecto Asignado" prefWidth="250"/>
                                        <TableColumn fx:id="colStatus" text="Estado General" prefWidth="120"/>
                                    </columns>
                                </TableView>
                                
                                <HBox spacing="12.0">
                                    <children>
                                        <Button onAction="#handleViewDocuments" text="Ver Documentos del Estudiante"
                                                style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
                                        <Button onAction="#handleViewReports" text="Ver Reportes del Estudiante"
                                                style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
