<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.internshipprogramsystem.gui.controllers.ProjectHomeDashboardController">
    
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="70.0" spacing="20.0" style="-fx-background-color:#4a90e2;" BorderPane.alignment="CENTER">
            <children>
                <StackPane prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #e8a020; -fx-background-radius: 10;">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <children>
                        <Label text="ES" textFill="WHITE">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                    </children>
                </StackPane>
                
                <Button fx:id="btnHome" mnemonicParsing="false" onAction="#goHome" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: transparent;" text="⌂" textFill="WHITE" />
                
                <Button fx:id="btnProjects" mnemonicParsing="false" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10;" text="🛠️" textFill="WHITE" />
                
                <Button fx:id="btnDocuments" mnemonicParsing="false" onAction="#goDocumentsModule" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: transparent;" text="📑" textFill="WHITE" />
                
                <Button fx:id="btnReports" mnemonicParsing="false" onAction="#goReportsModule" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: transparent;" text="📋" textFill="WHITE" />
                
                <Button fx:id="btnSelfAssessments" mnemonicParsing="false" onAction="#goSelfAssessmentsModule" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: transparent;" text="📝" textFill="WHITE" />
                
                <Region VBox.vgrow="ALWAYS" />
                
                <Button fx:id="btnExit" mnemonicParsing="false" onAction="#logOut" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: transparent;" text="🚪" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Módulo de Proyectos" textFill="#1a2744">
                                            <font><Font name="System Bold" size="22.0" /></font>
                                        </Label>
                                        <Label text="Gestiona tus postulaciones y explora el catálogo disponible" textFill="#6b7280" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: rgba(0,0,0,0.07); -fx-border-radius: 10;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Mis Postulaciones Activas" textFill="#4a90e2">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnCancelApplication" disable="true" mnemonicParsing="false" onAction="#cancelApplication" style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-border-color: #fecaca; -fx-border-radius: 6; -fx-background-radius: 6;" text="Cancelar Postulación" />
                                    </children>
                                </HBox>
                                <Separator />
                                <TableView fx:id="tblApplications" prefHeight="120.0" style="-fx-background-color: transparent;">
                                    <columns>
                                        <TableColumn fx:id="colAppProject" prefWidth="350.0" text="Proyecto Solicitado" />
                                        <TableColumn fx:id="colAppOrganization" prefWidth="250.0" text="Organización" />
                                        <TableColumn fx:id="colAppDate" prefWidth="120.0" text="Fecha Solicitud" />
                                        <TableColumn fx:id="colAppStatus" prefWidth="150.0" text="Estado Actual" />
                                    </columns>
                                    <placeholder>
                                        <Label text="No tienes postulaciones activas en este momento." textFill="#6b7280" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: rgba(0,0,0,0.07); -fx-border-radius: 10;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Catálogo de Proyectos Disponibles" textFill="#4a90e2">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>
                                <Separator />
                                
                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Buscar por palabra clave:" textFill="#4b5563">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                                <TextField fx:id="txtSearchProject" prefHeight="35.0" promptText="Ej. Base de datos, Desarrollo, nombre de empresa..." />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" prefWidth="200.0">
                                            <children>
                                                <Label text="Filtrar por Área:" textFill="#4b5563">
                                                    <font><Font size="11.0" /></font>
                                                </Label>
                                                <ComboBox fx:id="cmbAreaFilter" prefHeight="35.0" prefWidth="200.0" promptText="Todas las áreas" />
                                            </children>
                                        </VBox>
                                        <VBox alignment="BOTTOM_CENTER">
                                            <children>
                                                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefHeight="35.0" style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 6;" text="Buscar">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Button>
                                            </children>
                                        </VBox>
                                        <VBox alignment="BOTTOM_CENTER">
                                            <children>
                                                <Button fx:id="btnClearFilters" mnemonicParsing="false" onAction="#clearFilters" prefHeight="35.0" style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-text-fill: #4b5563;" text="Limpiar" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <TableView fx:id="tblAvailableProjects" prefHeight="300.0" style="-fx-background-color: transparent;">
                                    <columns>
                                        <TableColumn fx:id="colProjName" prefWidth="350.0" text="Nombre del Proyecto" />
                                        <TableColumn fx:id="colProjOrganization" prefWidth="220.0" text="Organización" />
                                        <TableColumn fx:id="colProjArea" prefWidth="180.0" text="Área Principal" />
                                        <TableColumn fx:id="colProjSpots" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Cupos" />
                                    </columns>
                                    <placeholder>
                                        <Label text="No se encontraron proyectos disponibles con esos filtros." textFill="#6b7280" />
                                    </placeholder>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <children>
                                        <Label text="Selecciona un proyecto de la lista para continuar" textFill="#9ca3af">
                                            <font><Font name="System Italic" size="12.0" /></font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnViewProjectDetails" disable="true" mnemonicParsing="false" onAction="#viewProjectDetails" prefHeight="38.0" style="-fx-background-color: white; -fx-border-color: #4a90e2; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #4a90e2;" text="Ver Detalles Completos" />
                                        <Button fx:id="btnApplyForProject" disable="true" mnemonicParsing="false" onAction="#applyForProject" prefHeight="38.0" style="-fx-background-color: #22c55e; -fx-background-radius: 6; -fx-text-fill: white;" text="Solicitar este Proyecto">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>