<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="320.0" prefWidth="480.0" style="-fx-background-color: #F8F9FA; -fx-border-color: #D6D6D6; -fx-border-width: 1px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.internshipprogramsystem.gui.controllers.DocumentCommentsDialogController">
    
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #0055A6;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <Label text="Observaciones del Revisor" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            
            <Label text="Detalle de la revisión:" textFill="#444444">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Label>
            
            <TextArea fx:id="txtComments" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif; -fx-font-size: 14px; -fx-control-inner-background: #FFFFFF; -fx-background-color: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 4px; -fx-padding: 5px;" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #EFEFEF; -fx-border-color: #D6D6D6; -fx-border-width: 1px 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <Button fx:id="btnClose" mnemonicParsing="false" onAction="#closeDialog" style="-fx-background-color: #0055A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 30px;" text="Cerrar" />
        </HBox>
    </bottom>

</BorderPane>