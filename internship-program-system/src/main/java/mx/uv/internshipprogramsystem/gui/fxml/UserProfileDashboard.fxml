<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="700.0"
            prefWidth="1000.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.UserProfileDashboardController">
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="25.0">
                    <padding>
                        <Insets bottom="40.0"
                                left="40.0"
                                right="40.0"
                                top="30.0" />
                    </padding>
                    <children>
                        <!-- Header with Title and Actions -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Mi perfil"
                                               textFill="#1a2744"
                                               style="-fx-font-size: 24; -fx-font-weight: bold;" />
                                        <Label text="Información de tu cuenta"
                                               textFill="#6b7280"
                                               style="-fx-font-size: 13;" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="btnLogout"
                                                text="Cerrar Sesión"
                                                onAction="#handleBtnLogoutClick"
                                                style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 16; -fx-cursor: hand;" />
                                        <Button fx:id="btnBack"
                                                text="🡠"
                                                onAction="#handleBtnBackClick"
                                                style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-text-fill: #1a2744;" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- User Info Card -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="20.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                            <children>
                                <StackPane prefHeight="80.0"
                                           prefWidth="80.0"
                                           style="-fx-background-color: #4a90e2; -fx-background-radius: 40;">
                                    <children>
                                        <Label fx:id="lblUserInitials"
                                               text="US"
                                               textFill="WHITE"
                                               style="-fx-font-size: 26; -fx-font-weight: bold;" />
                                    </children>
                                </StackPane>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label fx:id="lblFullName"
                                                       text="Nombre de Usuario"
                                                       textFill="#1a2744"
                                                       style="-fx-font-size: 20; -fx-font-weight: bold;" />
                                                <Label fx:id="lblRoleBadge"
                                                       text="Rol"
                                                       style="-fx-background-color: #e0ecff; -fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 11; -fx-padding: 4 10 4 10; -fx-background-radius: 12;" />
                                                <Label fx:id="lblStatusBadge"
                                                       text="● Activo"
                                                       style="-fx-background-color: #ecfdf5; -fx-text-fill: #065f46; -fx-font-weight: bold; -fx-font-size: 11; -fx-padding: 4 10 4 10; -fx-background-radius: 12;" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblEmail"
                                               text="correo@estudiantes.uv.mx"
                                               textFill="#6b7280"
                                               style="-fx-font-size: 14;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Two Column details -->
                        <HBox spacing="20.0" alignment="TOP_CENTER">
                            <children>
                                <!-- Personal Data Card -->
                                <VBox spacing="15.0"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="👤" style="-fx-font-size: 16;" />
                                                <Label text="Datos personales"
                                                       textFill="#1a2744"
                                                       style="-fx-font-size: 15; -fx-font-weight: bold;" />
                                            </children>
                                        </HBox>
                                        <VBox spacing="12.0">
                                            <children>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="NOMBRE COMPLETO"
                                                               textFill="#9ca3af"
                                                               style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                        <Label fx:id="lblDetailFullName"
                                                               text="Cargando..."
                                                               textFill="#374151"
                                                               style="-fx-font-size: 14;" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="CORREO ELECTRÓNICO"
                                                               textFill="#9ca3af"
                                                               style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                        <Label fx:id="lblDetailEmail"
                                                               text="Cargando..."
                                                               textFill="#374151"
                                                               style="-fx-font-size: 14;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Account & Access Card -->
                                <VBox spacing="15.0"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="🔑" style="-fx-font-size: 16;" />
                                                <Label text="Cuenta y acceso"
                                                       textFill="#1a2744"
                                                       style="-fx-font-size: 15; -fx-font-weight: bold;" />
                                            </children>
                                        </HBox>
                                        <VBox spacing="12.0">
                                            <children>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="ROL ASIGNADO"
                                                               textFill="#9ca3af"
                                                               style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                        <Label fx:id="lblDetailRole"
                                                               text="Cargando..."
                                                               textFill="#374151"
                                                               style="-fx-font-size: 14;" />
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="pneCodeContainer" spacing="4.0">
                                                    <children>
                                                        <Label fx:id="lblDetailCodeTitle"
                                                               text="CÓDIGO DE IDENTIFICACIÓN"
                                                               textFill="#9ca3af"
                                                               style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                        <Label fx:id="lblDetailCode"
                                                               text="Cargando..."
                                                               textFill="#374151"
                                                               style="-fx-font-size: 14;" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="ESTADO DE CUENTA"
                                                               textFill="#9ca3af"
                                                               style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                        <Label fx:id="lblDetailStatus"
                                                               text="Cargando..."
                                                               textFill="#374151"
                                                               style="-fx-font-size: 14;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Session Info Card -->
                        <VBox spacing="15.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="📋" style="-fx-font-size: 16;" />
                                        <Label text="Información de sesión"
                                               textFill="#1a2744"
                                               style="-fx-font-size: 15; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>
                                <VBox spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="🕒 Último acceso" textFill="#6b7280" style="-fx-font-size: 13;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblSessionLastAccess" text="Sábado, 20 jun 2026 — 08:42" textFill="#1f2937" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" style="-fx-border-color: #f3f4f6; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                                            <children>
                                                <Label text="💻 Dispositivo" textFill="#6b7280" style="-fx-font-size: 13;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblSessionDevice" text="Cliente de Escritorio (JavaFX)" textFill="#1f2937" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" style="-fx-border-color: #f3f4f6; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                                            <children>
                                                <Label text="📍 Ubicación" textFill="#6b7280" style="-fx-font-size: 13;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblSessionLocation" text="Coatepec, Veracruz" textFill="#1f2937" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" style="-fx-border-color: #f3f4f6; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                                            <children>
                                                <Label text="⏳ Sesión activa desde" textFill="#6b7280" style="-fx-font-size: 13;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblSessionActiveSince" text="08:24 — hace 18 min" textFill="#1f2937" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
