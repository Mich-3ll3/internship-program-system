<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0"
            prefWidth="1000.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.internshipprogramsystem.gui.controllers.AdminHomeDashboardController">
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="30.0">
                    <padding>
                        <Insets bottom="40.0"
                                left="40.0"
                                right="40.0"
                                top="30.0" />
                    </padding>
                    <children>

                        <!-- Statistics Title -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Estadísticas de Profesores"
                                       textFill="#1f2937"
                                       style="-fx-font-size: 16; -fx-font-weight: bold;" />
                                <Label text="Resumen del personal docente en la plataforma"
                                       textFill="#6b7280"
                                       style="-fx-font-size: 12;" />
                            </children>
                        </VBox>

                        <!-- Statistics Cards Grid -->
                        <GridPane hgap="20.0"
                                  vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES" />
                                <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES" />
                                <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES" />
                                <ColumnConstraints percentWidth="25.0" hgrow="SOMETIMES" />
                            </columnConstraints>
                            <children>
                                <!-- Card 1: Total -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="15.0"
                                      style="-fx-background-color: #EBF3FF; -fx-background-radius: 12; -fx-border-color: #D9E8FC; -fx-border-radius: 12; -fx-padding: 15 20 15 20;"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <StackPane prefHeight="40.0"
                                                   prefWidth="40.0"
                                                   style="-fx-background-color: #D9E8FC; -fx-background-radius: 10;">
                                            <children>
                                                <Label text="👥"
                                                       style="-fx-font-size: 18;" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="TOTAL"
                                                       textFill="#4a90e2"
                                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                <Label fx:id="lblTotalProfessors"
                                                       text="0"
                                                       style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Card 2: Active -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="15.0"
                                      style="-fx-background-color: #EBF3FF; -fx-background-radius: 12; -fx-border-color: #D9E8FC; -fx-border-radius: 12; -fx-padding: 15 20 15 20;"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <StackPane prefHeight="40.0"
                                                   prefWidth="40.0"
                                                   style="-fx-background-color: #D9E8FC; -fx-background-radius: 10;">
                                            <children>
                                                <Label text="✅"
                                                       style="-fx-font-size: 18;" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="ACTIVOS"
                                                       textFill="#10b981"
                                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                <Label fx:id="lblActiveProfessors"
                                                       text="0"
                                                       style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Card 3: Inactive -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="15.0"
                                      style="-fx-background-color: #EBF3FF; -fx-background-radius: 12; -fx-border-color: #D9E8FC; -fx-border-radius: 12; -fx-padding: 15 20 15 20;"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <StackPane prefHeight="40.0"
                                                   prefWidth="40.0"
                                                   style="-fx-background-color: #D9E8FC; -fx-background-radius: 10;">
                                            <children>
                                                <Label text="❌"
                                                       style="-fx-font-size: 18;" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="INACTIVOS"
                                                       textFill="#ef4444"
                                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                <Label fx:id="lblInactiveProfessors"
                                                       text="0"
                                                       style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Card 4: Pending -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="15.0"
                                      style="-fx-background-color: #EBF3FF; -fx-background-radius: 12; -fx-border-color: #D9E8FC; -fx-border-radius: 12; -fx-padding: 15 20 15 20;"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="0">
                                    <children>
                                        <StackPane prefHeight="40.0"
                                                   prefWidth="40.0"
                                                   style="-fx-background-color: #D9E8FC; -fx-background-radius: 10;">
                                            <children>
                                                <Label text="⏳"
                                                       style="-fx-font-size: 18;" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="PENDIENTES"
                                                       textFill="#f59e0b"
                                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />
                                                <Label fx:id="lblPendingProfessors"
                                                       text="0"
                                                       style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>

                        <!-- Available Modules Title -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="MÓDULO DISPONIBLE"
                                       textFill="#1f2937"
                                       style="-fx-font-size: 16; -fx-font-weight: bold;" />
                                <Label text="Administración y control de módulos de sistema"
                                       textFill="#6b7280"
                                       style="-fx-font-size: 12;" />
                            </children>
                        </VBox>

                        <!-- Available Modules Box -->
                        <VBox spacing="15.0"
                              style="-fx-background-color: #1a2744; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 8);">
                            <children>
                                <HBox alignment="CENTER_LEFT"
                                      spacing="15.0">
                                    <children>
                                        <StackPane prefHeight="45.0"
                                                   prefWidth="45.0"
                                                   style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10;">
                                            <children>
                                                <Label text="🎓"
                                                       textFill="WHITE"
                                                       style="-fx-font-size: 22;" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label text="Módulo Profesores"
                                                       textFill="WHITE"
                                                       style="-fx-font-size: 18; -fx-font-weight: bold;" />
                                                <Label text="Gestión del cuerpo docente, asignaciones y estados de activación."
                                                       textFill="#9ca3af"
                                                       style="-fx-font-size: 13;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Region prefHeight="10.0" />

                                <!-- Horizontal sub-actions buttons -->
                                <HBox spacing="15.0"
                                      alignment="CENTER">
                                    <children>
                                        <Button text="🔍 Consulta"
                                                onAction="#handleBtnConsultaClick"
                                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-cursor: hand;" />
                                        <Button text="📝 Registro"
                                                onAction="#handleBtnRegistroClick"
                                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-cursor: hand;" />
                                        <Button text="✏️ Modificación"
                                                onAction="#handleBtnModificacionClick"
                                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-cursor: hand;" />
                                        <Button text="🔄 Cambio de Estado"
                                                onAction="#handleBtnCambioEstadoClick"
                                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>